# Local development (python manage.py runserver).
# Secrets are generated automatically into backend/.dev-secrets.json (git-ignored)
# on first run, so you only need a database URL here.
DJANGO_DEBUG=true
# e.g. postgres://USER:PASSWORD@localhost:5432/samaritan (omit USER:PASSWORD for local trust/peer auth)
DATABASE_URL=postgres://localhost:5432/samaritan
FRONTEND_URL=http://localhost:3000
