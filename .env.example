# ---- Required secrets (generate fresh values for every deployment) ----
# python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Comma-separated; first key encrypts, all keys decrypt (rotation).
FIELD_ENCRYPTION_KEYS=
POSTGRES_PASSWORD=

# ---- Database ----
POSTGRES_DB=samaritan
POSTGRES_USER=samaritan

# ---- Web ----
FRONTEND_URL=http://localhost:3000
DJANGO_ALLOWED_HOSTS=localhost,api
WEB_PORT=3000
# Behind HTTPS in production set these to true / your domain
SECURE_SSL_REDIRECT=false
AUTH_COOKIE_SECURE=false

# ---- First administrator (created on first start; must change password on sign-in) ----
ADMIN_EMAIL=admin@yourchurch.org
ADMIN_PASSWORD=

# ---- Email (password resets, invitations, messages) ----
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.org
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=Your Church <office@yourchurch.org>

# Reverse proxies in front of the API (for correct client IPs in lockout & audit)
AXES_PROXY_COUNT=1
